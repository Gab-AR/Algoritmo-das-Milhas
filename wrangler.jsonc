// Publicação na Cloudflare (Workers com arquivos estáticos).
// O build gera a pasta out/; o worker só atende /api/* e entrega o resto como arquivo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "algoritmo-das-milhas",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Criar o banco com `npx wrangler d1 create algoritmo-cliques` e colar aqui o database_id que ele mostrar.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "algoritmo-cliques",
      "database_id": "PREENCHER_DEPOIS_DE_CRIAR",
      "migrations_dir": "migrations"
    }
  ]
}
