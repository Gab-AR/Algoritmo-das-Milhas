// Publicação na Cloudflare (Workers com arquivos estáticos).
// O build gera a pasta out/; o worker só atende /api/* e entrega o resto como arquivo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "algoritmo-das-milhas",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // Contador de cliques (banco D1 criado no painel da Cloudflare em 11/11/2026)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "algoritmo-cliques",
      "database_id": "cd1fb2bb-69a0-4ff1-b5c1-79a0f0850917",
      "migrations_dir": "migrations"
    }
  ]
}
